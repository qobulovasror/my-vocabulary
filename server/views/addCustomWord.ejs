<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vocabulary app</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <!-- <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'> -->
    <style>
      .statistic {
        font-size: 16px;
      }
      a {
        text-decoration: none;
      }
      i {
        font-size: 28px;
      }
      .menu .card {
        height: 110px;
      }
    </style>
  </head>
  <body>
    <div class="container mt-2">
      <div class="card p-1 rounded">
        <% if (message) { %>
        <div
          id="alert"
          class="alert alert-success py-1 text-center"
          role="alert"
          style="position: absolute; left: 50%; transform: translateX(-50%)"
        >
          <%=message%>
        </div>
        <% }%>
        <form action="/bot/addWord" method="post">
          <div class="d-flex justify-content-between">
            <a class="btn btn-outline-primary px-1 py-0" href="/bot">
              <i class="bi bi-arrow-left"></i>
            </a>
            <h3 class="text-center">Yangi lug'at qo'shish</h3>
            <div></div>
          </div>
          <div class="mb-3">
            <label for="word" class="form-label">So'z (inglizcha)*</label>
            <input
              type="text"
              class="form-control"
              id="word"
              name="word"
              placeholder="Word(s), Collacation, Idiom"
              required
            />
          </div>
          <div class="mb-3">
            <label for="translation" class="form-label"
              >Tarjimasi (o'zbekchasi)*</label
            >
            <input
              type="text"
              class="form-control"
              id="translation"
              name="translation"
              placeholder="translation"
              required
            />
          </div>
          <div class="mb-3">
            <label for="description" class="form-label"
              >Izoh, qo'shimcha, transkripsiyasi (ixtiyoriy)</label
            >
            <input
              type="text"
              class="form-control"
              id="description"
              name="description"
              placeholder="description..."
            />
          </div>
          <div class="mb-3">
            <label for="type" class="form-label"
              >So'z turi (ot, fe'l, Idioma,...)</label
            >
            <input
              type="text"
              class="form-control"
              id="type"
              name="type"
              placeholder="word type (noun, verb, adj., ...)"
            />
          </div>
          <div class="mb-3">
            <label for="example" class="form-label"
              >Misol tuzilgan gap(ixtiyoriy)</label
            >
            <textarea
              class="form-control"
              id="example"
              name="example"
              rows="3"
              placeholder="Misol gap"
            ></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Kiritish</button>
        </form>
      </div>
    </div>
    <script>
      const alertWin = document.getElementById("alert");
      setTimeout(() => {
        alertWin.style.display = "none";
      }, 3000);
    </script>
  </body>
</html>
