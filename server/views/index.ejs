<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vocabulary app</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'> -->
     <style>
        .statistic {
            font-size: 16px;  
        }
        a {
            text-decoration: none;
        }
        i {
            font-size: 28px;
        }
        .menu .card {
            height: 110px;
        }
     </style>
</head>
<body>
    <div class="container mt-2">
        <div class="card p-1 rounded">
            <div class="d-flex justify-content-around">
                <img class="rounded-circle" src="<%=profile_img%>" style="width: 100px; height: 100px; margin-top: 5px;"/>
                <div class="text-center" style="width: 93%; margin: 0 7%;" >
                    <h3> <%= full_name%></h3>
                    <p style="margin: -5px 0 2px 0; font-style: italic;"> <%= phone_number %> </p>
                    <div class="row">
                        <div class="col text-center">
                            <span class="badge text-bg-primary" style="font-size: 17px;"><%=allWord%></span>
                            <p class="statistic">Jami so'zlar</p>
                        </div>
                        <div class="col text-center">
                            <span class="badge text-bg-primary" style="font-size: 17px;"><%=memoriedWords%></span>
                            <p class="statistic">Yodlanganlar</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container mt-2 text-center menu">
        <div class="row mb-2">
            <div class="col">
                <a class="card p-2 rounded">
                    <i class="bi bi-controller"></i>
                    So'z yod olish
                </a>
            </div>
            <div class="col">
                <a class="card p-2 rounded" href="/bot/addWord">
                    <i class="bi bi-patch-plus"></i>
                    Yangi so'zlar kiritish
                </a>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col">
                <a class="card p-2 rounded" href="/bot/allWords">
                    <i class="bi bi-list-check"></i>
                    Barcha so'zlar ro'yxati
                </a>
            </div>
            <div class="col">
                <a class="card p-2 rounded">
                    <i class="bi bi-sliders2"></i>
                    So'z yod olishi rejalatirish
                </a>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col">
                <a class="card p-2 rounded">
                    <i class="bi bi-check2-square"></i>
                    Yod olingan so'zlar
                </a>
            </div>
            <div class="col">
                <a class="card p-2 rounded">
                    <i class="bi bi-repeat"></i>
                    Takrorlash uchun so'zlar
                </a>
            </div>
        </div>
    </div>
</body>
</html>